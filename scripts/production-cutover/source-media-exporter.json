{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {"name": "ess-spindle-source-media-export", "namespace": "ess"},
  "spec": {
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "enableServiceLinks": false,
    "dnsPolicy": "None",
    "dnsConfig": {"nameservers": ["127.0.0.1"]},
    "nodeSelector": {"kubernetes.io/hostname": "ip-10-20-1-11"},
    "securityContext": {
      "runAsUser": 10091, "runAsGroup": 10091,
      "runAsNonRoot": true, "seccompProfile": {"type": "RuntimeDefault"}
    },
    "containers": [{
      "name": "export", "image": "busybox:1.36", "command": ["sleep", "3600"],
      "resources": {"requests": {"cpu": "10m", "memory": "16Mi"}, "limits": {"cpu": "100m", "memory": "128Mi"}},
      "securityContext": {"allowPrivilegeEscalation": false, "readOnlyRootFilesystem": true, "capabilities": {"drop": ["ALL"]}},
      "volumeMounts": [{"name": "source", "mountPath": "/media", "readOnly": true}]
    }],
    "volumes": [{"name": "source", "persistentVolumeClaim": {"claimName": "synapse-media-preseed", "readOnly": true}}]
  }
}
